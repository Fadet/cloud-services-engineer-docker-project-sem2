FRONTEND_PORT=80
BACKEND_PORT=8081
# Только для dev-стека: прямой порт бэкенда в обход балансировщика
BACKEND_DEBUG_PORT=18081

# --- Секреты ---
# Путь к htpasswd для basic-auth на /metrics.
# Раскомментировать после генерации настоящего файла — см. secrets/metrics.htpasswd.example
#METRICS_HTPASSWD_FILE=./secrets/metrics.htpasswd

# Путь к общему секрету, которым подписываются id заказов.
# По умолчанию подставляется заглушка ./secrets/order_id.secret.example из одних
# комментариев — бэкенд прочитает её как пустую, сгенерирует временный ключ на каждой
# реплике и напишет WARN. id при этом остаются непредсказуемыми и уникальными.
# Раскомментировать после генерации — см. secrets/order_id.secret.example
#ORDER_ID_SECRET_FILE=./secrets/order_id.secret
