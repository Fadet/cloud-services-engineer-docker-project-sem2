# Лежит в /etc/nginx/templates/, хотя подставлять уже нечего: так штатный entrypoint
# сам создаёт /etc/nginx/conf.d/default.conf и не ругается на невозможность его изменить.
server {
    listen 8081;
    server_name _;

    # DNS-резолвер Docker: имя backend перечитывается каждые 10s
    resolver 127.0.0.11 valid=10s ipv6=off;

    # liveness самого балансировщика (не зависит от бэкендов)
    location = /lb-health {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location / {
        # Переменная в proxy_pass => имя резолвится в рантайме и nginx перебирает
        # все A-записи по кругу. Статический upstream в OSS-nginx резолвит имя один
        # раз на старте и балансировки не даёт (параметр resolve есть только в Plus).
        # При переменной URI не подставляется автоматически — нужен $request_uri.
        set $backend_pool backend;
        proxy_pass http://$backend_pool:8081$request_uri;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # если реплика умерла — уходим на следующую
        proxy_connect_timeout     2s;
        proxy_next_upstream       error timeout http_502 http_503 http_504;
        proxy_next_upstream_tries 3;
    }
}
