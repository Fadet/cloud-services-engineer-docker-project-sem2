# Заглушка для секрета подписи идентификаторов заказов.
# Без настоящего секрета backend генерирует временный ключ при запуске.
# Создать общий секрет:
# openssl rand -hex 32 > secrets/order_id.secret
# chmod 0644 secrets/order_id.secret
# Запуск:
# ORDER_ID_SECRET_FILE=./secrets/order_id.secret \
# docker compose up -d --force-recreate backend
